{
  "name": "statsviz-pro",
  "version": "1.0.0",
  "description": "StatsViz Pro - 专业跨平台数据统计与可视化分析平台",
  "main": "src/main/main.js",
  "author": "solosingle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "web:start": "npx serve src/renderer"
  },
  "build": {
    "appId": "com.statsviz.app",
    "productName": "StatsViz Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Science"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}